{
  "name": "coding-usage",
  "displayName": "Coding Usage",
  "description": "Share Cursor/Trae usage statistics with your team",
  "version": "1.2.2",
  "publisher": "whyuds",
  "repository": {
    "type": "git",
    "url": "https://github.com/lasoons/CodingUsage.git"
  },
  "license": "MIT",
  "engines": {
    "vscode": "^1.74.0"
  },
  "categories": [
    "Other"
  ],
  "icon": "logo_256.png",
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "cursorUsage.refresh",
        "title": "Coding Usage: Refresh",
        "icon": "$(refresh)"
      },
      {
        "command": "cursorUsage.updateSession",
        "title": "Coding Usage: Update Session Token",
        "icon": "$(settings-gear)"
      },
      {
        "command": "cursorUsage.showOutput",
        "title": "Coding Usage: Show Output",
        "icon": "$(output)"
      },
      {
        "command": "cursorUsage.copyApiKey",
        "title": "Coding Usage: Copy Client API Key",
        "icon": "$(copy)"
      },
      {
        "command": "cursorUsage.exportLogs",
        "title": "Coding Usage: Export Session Logs",
        "icon": "$(export)"
      }
    ],
    "icons": {
      "antigravity-logo": {
        "description": "Antigravity Logo",
        "default": {
          "fontPath": "./resources/fonts/coding-usage-icons.woff",
          "fontCharacter": "\\E001"
        }
      },
      "cursor-logo": {
        "description": "Cursor Logo",
        "default": {
          "fontPath": "./resources/fonts/coding-usage-icons.woff",
          "fontCharacter": "\\E002"
        }
      },
      "trae-logo": {
        "description": "Trae Logo",
        "default": {
          "fontPath": "./resources/fonts/coding-usage-icons.woff",
          "fontCharacter": "\\E003"
        }
      }
    },
    "configuration": {
      "title": "Coding Usage",
      "properties": {
        "cursorUsage.additionalSessionTokens": {
          "type": "array",
          "items": {
            "type": "string",
            "editPresentation": "multilineText"
          },
          "default": [],
          "maxItems": 3,
          "markdownDescription": "Additional session tokens for secondary accounts (max 3). Only displays usage, no data submission to team server.\n\n**Note**: Tokens are long strings. For better editing, use `settings.json` directly."
        },
        "cursorUsage.teamServerUrl": {
          "type": "string",
          "default": "",
          "description": "Team server base URL for usage reporting"
        },
        "cursorUsage.clientApiKey": {
          "type": "string",
          "default": "",
          "description": "Auto-generated client API key (based on app name and account). Automatically updates when account changes.",
          "readOnly": true
        },
        "cursorUsage.enableReporting": {
          "type": "boolean",
          "default": false,
          "description": "Enable reporting usage data to team server (default: disabled)"
        },
        "cursorUsage.showAllProviders": {
          "type": "boolean",
          "default": false,
          "description": "Show usage for all supported IDEs (Cursor, Trae, Antigravity) regardless of the current IDE."
        },
        "cursorUsage.recentEventsLimit": {
          "type": "integer",
          "default": 4,
          "minimum": 0,
          "maximum": 60,
          "description": "Maximum number of recent events to display in tooltip (0 to disable)"
        },
        "cursorUsage.showPromptCacheTimer": {
          "type": "boolean",
          "default": true,
          "description": "Show PromptCache countdown timer in status bar"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src --ext ts",
    "test": "node ./out/test/runTest.js",
    "package": "node esbuild.js",
    "package:trae": "node build/package-manager.js trae",
    "package:cursor": "node build/package-manager.js cursor",
    "package:antigravity": "node build/package-manager.js antigravity",
    "package:all": "node build/package-manager.js all",
    "build-icons": "node ./build/build-icons.js"
  },
  "devDependencies": {
    "@types/fs-extra": "^11.0.4",
    "@types/node": "16.x",
    "@types/sql.js": "^1.4.9",
    "@types/vscode": "^1.74.0",
    "@typescript-eslint/eslint-plugin": "^5.45.0",
    "@typescript-eslint/parser": "^5.45.0",
    "esbuild": "^0.19.0",
    "esbuild-plugin-copy": "^2.1.1",
    "eslint": "^8.28.0",
    "typescript": "^4.9.4",
    "webfont": "^11.2.26"
  },
  "dependencies": {
    "axios": "^1.6.0",
    "fs-extra": "^11.1.1",
    "sql.js": "^1.9.0"
  }
}